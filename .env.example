# 默认使用本地规则叙事器，不需要 API Key，也不会产生 API 费用。
XIU_NARRATOR=local
XIU_SAVE_NAME=autosave

# 若要启用 OpenAI Responses API，请复制本文件为 .env，再取消下面各行注释。
# .env 已被 Git 忽略；不要把真实 API Key 提交到仓库。
# XIU_NARRATOR=openai
# OPENAI_API_KEY=sk-...
# XIU_MODEL=gpt-5.4
# XIU_API_BASE=https://api.openai.com/v1
# XIU_API_TIMEOUT=45
